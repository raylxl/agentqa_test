# -*- coding: utf-8 -*-
r"""
通用用例册组装+结构门禁脚本（assemble_universal v1.0）
=====================================================
定位：所有需求共用的组装脚本模板——各需求的 _assemble.py 只写配置区，通用逻辑全部在本文件。
落标：L6 v1.6 用例册统计摘要 + L1 结构要求 + usecase-generator 技能组装步骤。

用法（各需求 _assemble.py 模板）：
    import sys, os
    sys.path.insert(0, r'D:\ZCodetest\.zcode\skills\usecase-generator\scripts')
    from assemble_universal import AssembleConfig, run
    cfg = AssembleConfig()
    cfg.BASE = r'D:\ZCodetest\需求用例库\用例文件\{菜单}分章'
    cfg.FILES = ['01_xx.md', '02_xx.md', ...]
    cfg.OUT = r'D:\ZCodetest\需求用例库\用例文件\财务需求{年}_{族}_{菜单}_{版本}_测试用例_v2.md'
    cfg.TITLE = '财务需求{年}_{族}_{菜单}_{版本} 测试用例'
    cfg.INTRO_FILE = '导语.md'
    cfg.PRE_FILE = 'PRE.md'
    cfg.FOOTER_FILE = '修改记录.md'
    cfg.LETTERS = 'FMN'  # 拍板编号首字母集（污染扫描用）
    cfg.SYS_FILE = '17_SYS_xxx.md'  # 可选：SYS章文件名
    cfg.DEF_FILE = '18_DEF_xxx.md'  # 可选：DEF章文件名
    cfg.IMP_FILE = '19_IMP_xxx.md'  # 可选：IMP章文件名
    cfg.HEADER_EXTRA = ''  # 可选：需求一句话+依据链等（替代旧 HEADER f-string 的自定义部分）
    run(cfg)
"""
import re, os, sys, io, glob

class AssembleConfig:
    """各需求组装配置——只设值不改逻辑"""
    def __init__(self):
        self.BASE = ''           # 分章目录绝对路径
        self.FILES = []          # 分章文件名列表（按序）
        self.OUT = ''            # 成册输出路径
        self.TITLE = ''          # 成册标题
        self.INTRO_FILE = ''     # 导语文件名（分章目录下）
        self.PRE_FILE = ''       # PRE文件名
        self.FOOTER_FILE = ''    # 修改记录文件名
        self.LETTERS = 'FMN'     # 拍板编号首字母集
        self.SYS_FILE = ''       # SYS章文件名（有增量模块时设）
        self.DEF_FILE = ''       # DEF章文件名
        self.IMP_FILE = ''       # IMP章文件名
        self.HEADER_EXTRA = ''   # 需求自定义头部文本（需求一句话/依据链/体例/断言口径等）

def _mk_pollute(letters):
    return re.compile(r'(?:^|[^A-Za-z0-9])[' + letters + r']\d{1,3}(?![0-9A-Za-z])')

def _read(path):
    return io.open(path, encoding='utf-8').read()

def _write(path, content):
    io.open(path, 'w', encoding='utf-8').write(content)

def _read_or(path, default=''):
    if path and os.path.exists(path):
        return _read(path)
    return default

def run(cfg):
    assert cfg.BASE and cfg.FILES and cfg.OUT, 'BASE/FILES/OUT 必填'

    tc_re  = re.compile(r'^####\s+(TC-[A-Z]+-\d+)')
    pri_re = re.compile(r'（(P[012])）')
    fm_re  = _mk_pollute(cfg.LETTERS)

    report = {"chapters": [], "dups": [], "gaps": [], "bad_blocks": [], "pollution": []}
    all_ids = []
    collide = {}
    parts = []
    grand = [0, 0, 0, 0]

    for fn in cfg.FILES:
        path = os.path.join(cfg.BASE, fn)
        lines = _read(path).split('\n')
        lines = [l for l in lines if not l.startswith('# ')]  # 去文件级 # 标题

        ids = [tc_re.match(l).group(1) for l in lines if tc_re.match(l)]
        all_ids += ids
        pris = [pri_re.search(l).group(1) for l in lines if tc_re.match(l)]
        p = [pris.count('P0'), pris.count('P1'), pris.count('P2')]
        total = len(ids)

        seen = set()
        for i in ids:
            if i in seen: report["dups"].append(f"{fn}:{i}")
            seen.add(i)
        nums = sorted(int(i.rsplit('-',1)[1]) for i in ids)
        if nums and nums != list(range(nums[0], nums[-1]+1)):
            report["gaps"].append(f"{fn}: {nums[0]}~{nums[-1]} 有断号")

        # 五列表 state 机校验
        cur = None; state = 0
        def flush(c, s, ln):
            if c and s != 3:
                report["bad_blocks"].append(f"{fn}:{ln}:{c} 表结构不完整(state={s})")
        for idx, l in enumerate(lines, 1):
            m = tc_re.match(l)
            if m:
                flush(cur, state, idx); cur = m.group(1); state = 0; continue
            if cur is None:
                if re.match(r'^#{2,3}\s', l):
                    hits = fm_re.findall(l)
                    if hits: report["pollution"].append(f"{fn}:{idx} 标题含编号{hits}: {l[:60]}")
                continue
            s = l.strip()
            if state == 0 and s.startswith('| 前置条件 | 操作步骤 | 预期结果 | 判断依据 | 测试方法 |'):
                state = 1; continue
            if state == 1 and re.match(r'^\|\s*-{3,}\s*\|', s):
                state = 2; continue
            if state == 2 and s.startswith('|'):
                cells = s.split('|')[1:-1]
                if len(cells) != 5:
                    report["bad_blocks"].append(f"{fn}:{idx}:{cur} 数据行列数={len(cells)}≠5")
                else:
                    if not ('（源：' in cells[3] or '（源:' in cells[3]):
                        report["bad_blocks"].append(f"{fn}:{idx}:{cur} 判断依据无源引用")
                    for ci, cell in enumerate(cells[:3]):
                        hits = fm_re.findall(cell)
                        if hits: report["pollution"].append(f"{fn}:{idx} {cur} 第{ci+1}格含编号{hits}")
                state = 3; continue
            if state == 3 and s.startswith('|'):
                report["bad_blocks"].append(f"{fn}:{idx}:{cur} 表后多余表格行")
        flush(cur, state, len(lines))

        # 跨章撞号
        for pat in (r'DO\d{2}\d{4}', r'WD\d{2}\d{4}'):
            for tok in set(re.findall(pat, '\n'.join(lines))):
                collide.setdefault(tok, set()).add(fn)

        # 计数回填+组装
        res = []; buf = []; sec_head = None
        def sec_count(buf_lines):
            return sum(1 for x in buf_lines if tc_re.match(x))
        for l in lines:
            if l.startswith('### '):
                if sec_head is not None:
                    res.append(re.sub(r'（(?:\?\?|\d+)\s*条）', f"（{sec_count(buf)} 条）", sec_head, count=1)); res.extend(buf)
                sec_head = l; buf = []
            elif l.startswith('## '):
                if sec_head is not None:
                    res.append(re.sub(r'（(?:\?\?|\d+)\s*条）', f"（{sec_count(buf)} 条）", sec_head, count=1)); res.extend(buf); sec_head = None; buf = []
                res.append(re.sub(r'（(?:\?\?|\d+)\s*条）', f"（{total} 条）", l, count=1))
            else:
                if sec_head is not None: buf.append(l)
                else: res.append(l)
        if sec_head is not None:
            res.append(re.sub(r'（(?:\?\?|\d+)\s*条）', f"（{sec_count(buf)} 条）", sec_head, count=1)); res.extend(buf)

        chapter_title = next((l for l in lines if l.startswith('## ')), '').lstrip('# ').strip()
        report["chapters"].append((re.sub(r'（(?:\?\?|\d+)\s*条）', '', chapter_title).strip(), total, p))
        grand[0] += total; grand[1] += p[0]; grand[2] += p[1]; grand[3] += p[2]
        parts.append('\n'.join(res).rstrip())

    # === 统计摘要计算 ===
    total_tc = grand[0]
    invalid_count = 0
    for fn in cfg.FILES:
        for l in _read(os.path.join(cfg.BASE, fn)).split('\n'):
            if l.startswith('#### ') and '〔已失效〕' in l:
                invalid_count += 1
    sys_count = sum(1 for l in _read(os.path.join(cfg.BASE, cfg.SYS_FILE)).split('\n') if l.startswith('#### TC-')) if cfg.SYS_FILE else 0
    def_count = sum(1 for l in _read(os.path.join(cfg.BASE, cfg.DEF_FILE)).split('\n') if l.startswith('#### TC-')) if cfg.DEF_FILE else 0
    imp_count = sum(1 for l in _read(os.path.join(cfg.BASE, cfg.IMP_FILE)).split('\n') if l.startswith('#### TC-')) if cfg.IMP_FILE else 0
    orig_count = total_tc - sys_count - def_count - imp_count
    effective = total_tc - invalid_count

    summary_block = ""
    if sys_count or def_count or imp_count:
        # 有增量模块的册（已执行+回写过）
        summary_block = f"""
> **用例册统计摘要**（截至本次组装）
>
> | 维度 | 数量 | 说明 |
> | --- | --- | --- |
> | **用例总数** | **{total_tc}** | P0={grand[1]}/P1={grand[2]}/P2={grand[3]} |
> | 原始设计用例（一~十六章） | {orig_count} | 首次生成+首轮修复后版本 |
> | ↳ 已失效 | {invalid_count} | 预期被系统实现推翻，标题标〔已失效〕，场景由增量模块承接 |
> | ↳ 有效可执行 | {orig_count - invalid_count} | 含首轮已执行+待执行（计费章） |
> | 新增·系统与用例不符（SYS） | {sys_count} | 十七章：系统实现与原用例预期不一致的修正用例（挂老用例编号） |
> | 新增·缺陷数据场景（DEF） | {def_count} | 十八章：缺陷单引入的新增测试场景 |
> | 新增·实现行为固化（IMP） | {imp_count} | 十九章：需求未定义、系统已实现的合理行为固化 |
> | **有效可执行合计** | **{effective}** | = 总数 − 已失效；执行遇〔已失效〕跳过、以 SYS/DEF/IMP 对应条执行 |
"""
    else:
        # 未执行/未回写的初始册
        summary_block = f"""
> **用例册统计摘要**（初始版，尚未执行）
>
> | 维度 | 数量 | 说明 |
> | --- | --- | --- |
> | **用例总数** | **{total_tc}** | P0={grand[1]}/P1={grand[2]}/P2={grand[3]} |
> | 原始设计用例 | {orig_count} | 本次生成版本 |
> | ↳ 已失效 | 0 | 尚未执行，无失效 |
> | ↳ 有效可执行 | {orig_count} | 全部待执行 |
"""

    stat_rows = "\n".join(f"| {t} | {n} | {a} | {b} | {c} |" for t, n, (a, b, c) in report["chapters"])
    total_line = f"| **合计** | **{grand[0]}** | **{grand[1]}** | **{grand[2]}** | **{grand[3]}** |"

    LEAD = _read_or(os.path.join(cfg.BASE, cfg.INTRO_FILE) if cfg.INTRO_FILE else '', '')
    PRE = _read_or(os.path.join(cfg.BASE, cfg.PRE_FILE) if cfg.PRE_FILE else '', '')
    FOOTER = '\n---\n\n' + _read_or(os.path.join(cfg.BASE, cfg.FOOTER_FILE) if cfg.FOOTER_FILE else '', '') + '\n' if cfg.FOOTER_FILE else ''

    HEADER = f"""# {cfg.TITLE}

{cfg.HEADER_EXTRA}

{LEAD}

{summary_block}

| 章 | 条数 | P0 | P1 | P2 |
| --- | --- | --- | --- | --- |
{stat_rows}
{total_line}
"""

    final = HEADER + ('\n\n' + PRE if PRE else '') + '\n\n' + '\n\n---\n\n'.join(parts) + FOOTER

    ok = not (report["dups"] or report["gaps"] or report["bad_blocks"] or report["pollution"] or
              {k: v for k, v in collide.items() if len(v) > 1})
    out = cfg.OUT if ok else cfg.OUT + '.draft'
    _write(out, final)

    # 输出报告
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
    print("=== 组装 ===")
    print(f"输出: {out}")
    print(f"总条数={grand[0]}  P0={grand[1]}  P1={grand[2]}  P2={grand[3]}")
    for t, n, p in report["chapters"]:
        print(f"  {t}: {n} 条 (P0={p[0]} P1={p[1]} P2={p[2]})")
    print(f"\n=== 结构门禁 ===")
    print(f"重号: {report['dups'] or '无'}")
    print(f"断号: {report['gaps'] or '无'}")
    print(f"五列表/源引用缺失: {len(report['bad_blocks'])} 处 {report['bad_blocks'][:10] or ''}")
    print(f"正文/标题拍板编号污染: {len(report['pollution'])} 处")
    for x in report["pollution"][:20]: print("  ", x)
    cross = {k: sorted(v) for k, v in collide.items() if len(v) > 1}
    print(f"跨章订单/运单撞号: {cross or '无'}")
    print(f"\n=== 统计摘要 ===")
    print(f"总数={total_tc} 原始={orig_count} 失效={invalid_count} SYS={sys_count} DEF={def_count} IMP={imp_count} 有效={effective}")
    print(f"\n===> {'全绿' if ok else '存在违例，修复分章后重跑'}")
